<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:controls="clr-namespace:Zubrium.Maui.Views.Controls"
             xmlns:local="clr-namespace:Zubrium.Maui.Features.Quizs"
             xmlns:vm="clr-namespace:Zubrium.Maui.ViewModels"
             x:Class="Zubrium.Maui.Features.Quizs.PickQuizPage"
             x:DataType="local:PickQuizViewModel"
             x:Name="PickQuizPageRoot"
             BackgroundColor="#F4F5F8">

    <ScrollView>
        <VerticalStackLayout Padding="20,20,20,40" Spacing="20">
            <controls:DesktopBackButton />

            <Label Text="Выберите категорию" FontSize="28" FontAttributes="Bold" TextColor="#1C1C1E" />

            <Border BackgroundColor="White" Stroke="#EAECEF" StrokeThickness="1" Padding="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#000000" Offset="0,4" Radius="12" Opacity="0.03" />
                </Border.Shadow>

                <CollectionView ItemsSource="{Binding Categories}" SelectionMode="None">
                    <CollectionView.EmptyView>
                        <Label Text="Нет категорий с квизами" TextColor="#8E8E93" HorizontalOptions="Center" Margin="20" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:CategoryDisplayModel">
                            <VerticalStackLayout>
                                <Grid ColumnDefinitions="Auto, *" Padding="16,18" ColumnSpacing="16" BackgroundColor="Transparent">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding BindingContext.SelectCategoryCommand, Source={x:Reference PickQuizPageRoot}}" CommandParameter="{Binding CategoryId}" />
                                    </Grid.GestureRecognizers>
                                    <Grid.Behaviors>
                                        <toolkit:TouchBehavior DefaultBackgroundColor="Transparent" PressedBackgroundColor="#F2F2F6" DefaultOpacity="1.0" PressedOpacity="0.5" PressedAnimationDuration="100" DefaultAnimationDuration="100" />
                                    </Grid.Behaviors>
                                    <Image Grid.Column="0" Source="{mi:Material Icon=Science}" WidthRequest="28" HeightRequest="28" VerticalOptions="Center">
                                        <Image.Behaviors>
                                            <toolkit:IconTintColorBehavior TintColor="{Binding IconColor}" />
                                        </Image.Behaviors>
                                    </Image>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                                        <Label Text="{Binding Name}" FontSize="16" TextColor="#2C2C2E" FontAttributes="Bold" />
                                        <Label Text="{Binding ItemCountText}" FontSize="13" TextColor="#8E8E93" />
                                    </VerticalStackLayout>
                                </Grid>
                                <BoxView HeightRequest="1" Color="#F2F2F6" Margin="16,0" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>