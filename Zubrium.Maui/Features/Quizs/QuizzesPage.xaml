<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Zubrium.Maui.Views.Controls"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:local="clr-namespace:Zubrium.Maui.Features.Quizs"
             x:Class="Zubrium.Maui.Features.Quizs.QuizzesPage"
             x:DataType="local:QuizzesViewModel"
             BackgroundColor="#F4F5F8">
    <!-- Светло-серый фон страницы -->

    <!-- Корневой Grid для того, чтобы плавающая кнопка (FAB) была поверх контента -->
    <Grid>

        <ScrollView>
            <!-- Нижний отступ увеличен (100), чтобы контент не перекрывался плавающей кнопкой -->
            <VerticalStackLayout Padding="20,20,20,100" Spacing="20">

                <!-- Заголовок и кнопка Импортировать -->
                <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                    <Label Text="Квизы"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="#1C1C1E"
                           VerticalOptions="Center" />

                    <Label Grid.Column="1"
                           Text="ИМПОРТИРОВАТЬ"
                           FontSize="12"
                           TextColor="#6278E6"
                           TextTransform="Uppercase"
                           FontAttributes="Bold"
                           VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ImportCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

                <!-- Поиск -->
                <Border BackgroundColor="#EFEFF4"
                        StrokeThickness="0"
                        Padding="16,8">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto, *">
                        <Image Grid.Column="0"
                               Source="{mi:Material Icon=Search, IconColor=#8E8E93}"
                               WidthRequest="22"
                               HeightRequest="22"
                               VerticalOptions="Center"
                               Margin="0,0,12,0" />
                        <Entry Grid.Column="1"
                               Placeholder="Поиск..."
                               PlaceholderColor="#8E8E93"
                               TextColor="#1C1C1E"
                               BackgroundColor="Transparent"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Единый список категорий квизов -->
                <Border BackgroundColor="White"
                        Stroke="#EAECEF"
                        StrokeThickness="1"
                        Padding="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#000000" Offset="0,4" Radius="12" Opacity="0.03" />
                    </Border.Shadow>

                    <!-- Вы можете заменить этот StackLayout на CollectionView 
                         или использовать BindableLayout.ItemsSource для динамических данных -->
                    <VerticalStackLayout>

                        <!-- Категория 1 -->
                        <Grid ColumnDefinitions="Auto, *" Padding="16,18" ColumnSpacing="16" BackgroundColor="Transparent">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenQuizCategoryCommand}" CommandParameter="Calculus" />
                            </Grid.GestureRecognizers>
                            <Grid.Behaviors>
                                <toolkit:TouchBehavior DefaultBackgroundColor="Transparent"
                                                       PressedBackgroundColor="#F2F2F6"
                                                       DefaultOpacity="1.0"
                                                       PressedOpacity="0.5"
                                                       PressedAnimationDuration="100"
                                                       DefaultAnimationDuration="100" />
                            </Grid.Behaviors>

                            <Image Grid.Column="0" Source="{mi:Material Icon=MenuBook, IconColor=#8E95A4}" WidthRequest="28" HeightRequest="28" VerticalOptions="Center" InputTransparent="True"/>

                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4" InputTransparent="True">
                                <Label Text="Multivariable Calculus" FontSize="16" TextColor="#2C2C2E" FontAttributes="Bold" />
                                <Label Text="22 квиза" FontSize="13" TextColor="#8E8E93" />
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Разделитель -->
                        <BoxView HeightRequest="1" Color="#F2F2F6" Margin="16,0" />

                        <!-- Категория 2 -->
                        <Grid ColumnDefinitions="Auto, *" Padding="16,18" ColumnSpacing="16" BackgroundColor="Transparent">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenQuizCategoryCommand}" CommandParameter="Electronics" />
                            </Grid.GestureRecognizers>
                            <Grid.Behaviors>
                                <toolkit:TouchBehavior DefaultBackgroundColor="Transparent"
                                                       PressedBackgroundColor="#F2F2F6"
                                                       DefaultOpacity="1.0"
                                                       PressedOpacity="0.5"
                                                       PressedAnimationDuration="100"
                                                       DefaultAnimationDuration="100" />
                            </Grid.Behaviors>

                            <Image Grid.Column="0" Source="{mi:Material Icon=Memory, IconColor=#66BB6A}" WidthRequest="28" HeightRequest="28" VerticalOptions="Center" InputTransparent="True"/>

                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4" InputTransparent="True">
                                <Label Text="Электроника" FontSize="16" TextColor="#2C2C2E" FontAttributes="Bold" />
                                <Label Text="41 квиз" FontSize="13" TextColor="#8E8E93" />
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Разделитель -->
                        <BoxView HeightRequest="1" Color="#F2F2F6" Margin="16,0" />

                        <!-- Категория 3 -->
                        <Grid ColumnDefinitions="Auto, *" Padding="16,18" ColumnSpacing="16" BackgroundColor="Transparent">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenQuizCategoryCommand}" CommandParameter="Anatomy" />
                            </Grid.GestureRecognizers>
                            <Grid.Behaviors>
                                <toolkit:TouchBehavior DefaultBackgroundColor="Transparent"
                                                       PressedBackgroundColor="#F2F2F6"
                                                       DefaultOpacity="1.0"
                                                       PressedOpacity="0.5"
                                                       PressedAnimationDuration="100"
                                                       DefaultAnimationDuration="100" />
                            </Grid.Behaviors>

                            <Image Grid.Column="0" Source="{mi:Material Icon=Accessibility, IconColor=#FFA726}" WidthRequest="28" HeightRequest="28" VerticalOptions="Center" InputTransparent="True"/>

                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4" InputTransparent="True">
                                <Label Text="Анатомия" FontSize="16" TextColor="#2C2C2E" FontAttributes="Bold" />
                                <Label Text="12 квизов" FontSize="13" TextColor="#8E8E93" />
                            </VerticalStackLayout>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Плавающая кнопка (FAB) -->
        <Button Text="+ Квиз"
                BackgroundColor="#6278E6"
                TextColor="White"
                FontSize="16"
                FontAttributes="Bold"
                CornerRadius="24"
                HeightRequest="48"
                Padding="24,0"
                HorizontalOptions="Center"
                VerticalOptions="End"
                Margin="0,0,0,32"
                Command="{Binding CreateQuizCommand}">
            <Button.Shadow>
                <Shadow Brush="#6278E6" Offset="0,6" Radius="12" Opacity="0.4" />
            </Button.Shadow>
        </Button>

    </Grid>
</ContentPage>