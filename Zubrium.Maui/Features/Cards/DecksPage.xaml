<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:Zubrium.Maui.ViewModels"
             xmlns:md="clr-namespace:Zubrium.Maui.Views.Controls"
             xmlns:local="clr-namespace:Zubrium.Maui.Features.Cards"
             x:Class="Zubrium.Maui.Features.Cards.DecksPage"
             x:DataType="local:DecksViewModel">
    <ScrollView>
    <VerticalStackLayout>
        <md:MarkdownView 
            Text="{Binding Title}"
            TextColor="Black"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />

        
        <md:MarkdownView
            TextColor="Black"
            Text="{Binding BodyMarkdown}">
            
        </md:MarkdownView>
        
        <Button 
            Text="Render Markdown"
            Command="{Binding LoadArticleCommand}"
            BackgroundColor="#2196F3"
            TextColor="White" />
    </VerticalStackLayout>
    </ScrollView>
</ContentPage>