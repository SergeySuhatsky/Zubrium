<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:controls="clr-namespace:Zubrium.Maui.Views.Controls"
             xmlns:local="clr-namespace:Zubrium.Maui.Features.Study"
             xmlns:swipeCardView="clr-namespace:Plugin.Maui.SwipeCardView;assembly=Plugin.Maui.SwipeCardView"
             x:Class="Zubrium.Maui.Features.Study.StudySessionPage"
             x:DataType="local:StudySessionViewModel"
             x:Name="SessionPage"
             BackgroundColor="#F4F5F8">

    <Grid>
        <!-- ЭКРАН ЗАВЕРШЕНИЯ -->
        <VerticalStackLayout IsVisible="{Binding IsSessionFinished}" VerticalOptions="Center" HorizontalOptions="Center" Spacing="16" Padding="20">
            <Image Source="{mi:Material Icon=TaskAlt, IconColor=#34C759}" WidthRequest="80" HeightRequest="80" />
            <Label Text="Сессия завершена!" FontSize="24" FontAttributes="Bold" TextColor="#1C1C1E" HorizontalOptions="Center" />
            <Button Text="Вернуться" Command="{Binding FinishSessionCommand}" BackgroundColor="#6278E6" TextColor="White" CornerRadius="12" HeightRequest="48" Margin="0,20,0,0" />
        </VerticalStackLayout>

        <!-- ОСНОВНОЙ ИНТЕРФЕЙС -->
        <Grid IsVisible="{Binding HasCards}" RowDefinitions="Auto, *, Auto">

            <!-- Шапка -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Padding="20,16">
                <ImageButton Grid.Column="0" Source="{mi:Material Icon=Close, IconColor=#1C1C1E}" BackgroundColor="Transparent" WidthRequest="32" HeightRequest="32" Command="{Binding FinishSessionCommand}" />
                <Label Grid.Column="1" Text="{Binding CardsLeft, StringFormat='Осталось: {0}'}" FontSize="16" FontAttributes="Bold" TextColor="#1C1C1E" HorizontalOptions="Center" VerticalOptions="Center" />
                <ImageButton Grid.Column="2" Source="{mi:Material Icon=MoreVert, IconColor=#1C1C1E}" BackgroundColor="Transparent" WidthRequest="32" HeightRequest="32" Command="{Binding ToggleHiddenMenuCommand}" />
            </Grid>

            <!-- КАРТОЧКИ (SwipeCardView Plugin) -->
            <Grid Grid.Row="1" Padding="20,10,20,20">
                <swipeCardView:SwipeCardView
                    x:Name="CardSwipeView"
                    ItemsSource="{Binding Queue}"
                    TopItem="{Binding CurrentCard}"
                    SwipedCommand="{Binding CardSwipedCommand}"
                    SupportedSwipeDirections="Left, Right"
                    SupportedDraggingDirections="Left, Right"
                    StackDepth="2"
                    StackOffset="12"
                    StackScaleStep="0.04"
                    AnimationLength="250"
                    BackCardScale="0.95"
                    CardRotation="15">

                    <swipeCardView:SwipeCardView.ItemTemplate>
                        <DataTemplate x:DataType="local:StudyCardItem">

                            <Border BackgroundColor="White" StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="24" />
                                </Border.StrokeShape>
                                <Border.Shadow>
                                    <Shadow Brush="Black" Offset="0,8" Radius="16" Opacity="0.1" />
                                </Border.Shadow>

                                <Grid RowDefinitions="*, Auto">

                                    <Grid Grid.Row="0" Margin="24,24,24,0">
                                        <VerticalStackLayout Spacing="16">

                                            <!-- ВОПРОС -->
                                            <Label Text="{Binding DomainCard.Title}" FontSize="24" FontAttributes="Bold" TextColor="#1C1C1E" />
                                            <controls:MarkdownView Text="{Binding DomainCard.FrontMarkdown}" TextColor="#2C2C2E" InputTransparent="True" />

                                            <!-- Разделитель -->
                                            <BoxView HeightRequest="1" Color="#F2F2F6" Margin="0,8" 
                                                     IsVisible="{Binding BindingContext.IsBriefVisible, Source={x:Reference SessionPage}}" />

                                            <!-- КРАТКИЙ ОТВЕТ -->
                                            <VerticalStackLayout IsVisible="{Binding BindingContext.IsBriefVisible, Source={x:Reference SessionPage}}" Spacing="8">
                                                <Label Text="КРАТКИЙ ОТВЕТ" FontSize="11" TextColor="#8E8E93" FontAttributes="Bold" />
                                                <controls:MarkdownView Text="{Binding DomainCard.BriefMarkdown}" TextColor="#2C2C2E" InputTransparent="True" />
                                            </VerticalStackLayout>

                                            <!-- СПИННЕР -->
                                            <ActivityIndicator IsRunning="{Binding BindingContext.IsLoadingDetailed, Source={x:Reference SessionPage}}" 
                                                               IsVisible="{Binding BindingContext.IsLoadingDetailed, Source={x:Reference SessionPage}}" 
                                                               Color="#6278E6" HorizontalOptions="Center" Margin="0,10,0,0" />

                                            <BoxView HeightRequest="1" Color="#F2F2F6" Margin="0,8" 
                                                     IsVisible="{Binding BindingContext.IsDetailedVisible, Source={x:Reference SessionPage}}" />

                                            <!-- ПОДРОБНЫЙ ОТВЕТ -->
                                            <ScrollView IsVisible="{Binding BindingContext.IsDetailedVisible, Source={x:Reference SessionPage}}" VerticalScrollBarVisibility="Always">
                                                <VerticalStackLayout Spacing="8" Padding="0,0,0,24">
                                                    <Label Text="ПОДРОБНЫЙ ОТВЕТ" FontSize="11" TextColor="#8E8E93" FontAttributes="Bold" />
                                                    <controls:MarkdownView Text="{Binding DomainCard.DetailedMarkdown}" TextColor="#2C2C2E" InputTransparent="True" />
                                                </VerticalStackLayout>
                                            </ScrollView>

                                        </VerticalStackLayout>
                                    </Grid>

                                    <!-- КНОПКА ПОКАЗА ОТВЕТА (ВНИЗУ КАРТОЧКИ) -->
                                    <Border Grid.Row="1" BackgroundColor="#F4F5F8" StrokeThickness="0" Margin="16" Padding="16">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="16" />
                                        </Border.StrokeShape>

                                        <Border.Behaviors>
                                            <toolkit:TouchBehavior DefaultBackgroundColor="#F4F5F8" 
                                                                   PressedBackgroundColor="#EAECEF"
                                                                   Command="{Binding BindingContext.RevealBriefCommand, Source={x:Reference SessionPage}}"
                                                                   LongPressCommand="{Binding BindingContext.RevealDetailedCommand, Source={x:Reference SessionPage}}" />
                                        </Border.Behaviors>

                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding BindingContext.IsDetailedVisible, Source={x:Reference SessionPage}}" Value="True">
                                                <Setter Property="IsVisible" Value="False" />
                                            </DataTrigger>
                                        </Border.Triggers>

                                        <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8" InputTransparent="True">
                                            <Grid WidthRequest="20" HeightRequest="20">
                                                <Image Source="{mi:Material Icon=Visibility, IconColor=#8E8E93}" IsVisible="True">
                                                    <Image.Triggers>
                                                        <DataTrigger TargetType="Image" Binding="{Binding BindingContext.IsBriefVisible, Source={x:Reference SessionPage}}" Value="True">
                                                            <Setter Property="IsVisible" Value="False" />
                                                        </DataTrigger>
                                                    </Image.Triggers>
                                                </Image>
                                                <Image Source="{mi:Material Icon=MoreHoriz, IconColor=#8E8E93}" IsVisible="False">
                                                    <Image.Triggers>
                                                        <DataTrigger TargetType="Image" Binding="{Binding BindingContext.IsBriefVisible, Source={x:Reference SessionPage}}" Value="True">
                                                            <Setter Property="IsVisible" Value="True" />
                                                        </DataTrigger>
                                                    </Image.Triggers>
                                                </Image>
                                            </Grid>
                                            <Label FontSize="14" FontAttributes="Bold" TextColor="#8E8E93" VerticalOptions="Center">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding BindingContext.IsBriefVisible, Source={x:Reference SessionPage}}" Value="False">
                                                        <Setter Property="Text" Value="Показать ответ" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding BindingContext.IsBriefVisible, Source={x:Reference SessionPage}}" Value="True">
                                                        <Setter Property="Text" Value="Зажмите для подробностей" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </HorizontalStackLayout>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </swipeCardView:SwipeCardView.ItemTemplate>
                </swipeCardView:SwipeCardView>
            </Grid>

            <!-- НИЖНИЕ КНОПКИ УПРАВЛЕНИЯ -->
            <Grid Grid.Row="2" ColumnDefinitions="*, *" ColumnSpacing="16" Padding="20,10,20,30">

                <Button Grid.Column="0" Clicked="OnSwipeLeftClicked" HeightRequest="64" CornerRadius="32" FontAttributes="Bold" FontSize="16"
                        BackgroundColor="White" BorderColor="#EAECEF" BorderWidth="2">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding CurrentCard.Phase}" Value="Discovery">
                            <Setter Property="Text" Value="Уже знаю" />
                            <Setter Property="TextColor" Value="#8E8E93" />
                        </DataTrigger>
                        <DataTrigger TargetType="Button" Binding="{Binding CurrentCard.Phase}" Value="Review">
                            <Setter Property="Text" Value="Отложить" />
                            <Setter Property="TextColor" Value="#FF3B30" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

                <Button Grid.Column="1" Clicked="OnSwipeRightClicked" HeightRequest="64" CornerRadius="32" FontAttributes="Bold" FontSize="16" TextColor="White">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding CurrentCard.Phase}" Value="Discovery">
                            <Setter Property="Text" Value="Начать учить" />
                            <Setter Property="BackgroundColor" Value="#1C1C1E" />
                        </DataTrigger>
                        <DataTrigger TargetType="Button" Binding="{Binding CurrentCard.Phase}" Value="Review">
                            <Setter Property="Text" Value="Вспомнил" />
                            <Setter Property="BackgroundColor" Value="#34C759" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </Grid>
        </Grid>

        <!-- СКРЫТОЕ МЕНЮ (OVERLAY) -->
        <Grid BackgroundColor="#80000000" IsVisible="{Binding IsHiddenMenuVisible}" InputTransparent="False">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding ToggleHiddenMenuCommand}" />
            </Grid.GestureRecognizers>

            <Border BackgroundColor="White" VerticalOptions="End" StrokeThickness="0" Margin="16,0,16,32" Padding="8">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="0">
                    <Button Text="Откатить на 1 стадию" Command="{Binding RollbackProgressCommand}" BackgroundColor="Transparent" TextColor="#1C1C1E" FontSize="16" HeightRequest="56" />
                    <BoxView HeightRequest="1" Color="#EAECEF" Margin="16,0" />
                    <Button Text="Сбросить прогресс" Command="{Binding ResetProgressCommand}" BackgroundColor="Transparent" TextColor="#1C1C1E" FontSize="16" HeightRequest="56" />
                    <BoxView HeightRequest="1" Color="#EAECEF" Margin="16,0" />
                    <Button Text="Удалить слово" Command="{Binding DeleteCardCommand}" BackgroundColor="Transparent" TextColor="#FF3B30" FontAttributes="Bold" FontSize="16" HeightRequest="56" />
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>