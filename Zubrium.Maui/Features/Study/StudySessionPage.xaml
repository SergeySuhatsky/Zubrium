<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:controls="clr-namespace:Zubrium.Maui.Views.Controls"
             xmlns:local="clr-namespace:Zubrium.Maui.Features.Study"
             xmlns:swipeCardView="clr-namespace:Plugin.Maui.SwipeCardView;assembly=Plugin.Maui.SwipeCardView"
             x:Class="Zubrium.Maui.Features.Study.StudySessionPage"
             x:DataType="local:StudySessionViewModel"
             x:Name="SessionPage"
             BackgroundColor="#F4F5F8">

    <Grid>
        <!-- ЭКРАН ЗАВЕРШЕНИЯ -->
        <VerticalStackLayout IsVisible="{Binding IsSessionFinished}" VerticalOptions="Center" HorizontalOptions="Center" Spacing="16" Padding="20">
            <Image Source="{mi:Material Icon=TaskAlt, IconColor=#34C759}" WidthRequest="80" HeightRequest="80" />
            <Label Text="Сессия завершена!" FontSize="24" FontAttributes="Bold" TextColor="#1C1C1E" HorizontalOptions="Center" />
            <Button Text="Вернуться" Command="{Binding FinishSessionCommand}" BackgroundColor="#6278E6" TextColor="White" CornerRadius="12" HeightRequest="48" Margin="0,20,0,0" />
        </VerticalStackLayout>

        <!-- ОСНОВНОЙ ИНТЕРФЕЙС -->
        <Grid IsVisible="{Binding HasCards}" RowDefinitions="Auto, *, Auto">

            <!-- Шапка -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Padding="20,16">
                <ImageButton Grid.Column="0" Source="{mi:Material Icon=Close, IconColor=#1C1C1E}" BackgroundColor="Transparent" WidthRequest="32" HeightRequest="32" Command="{Binding FinishSessionCommand}" />
                <Label Grid.Column="1" Text="{Binding CardsLeft, StringFormat='Осталось: {0}'}" FontSize="16" FontAttributes="Bold" TextColor="#1C1C1E" HorizontalOptions="Center" VerticalOptions="Center" />
                <ImageButton Grid.Column="2" Source="{mi:Material Icon=MoreVert, IconColor=#1C1C1E}" BackgroundColor="Transparent" WidthRequest="32" HeightRequest="32" Command="{Binding ToggleHiddenMenuCommand}" />
            </Grid>

            <!-- КАРТОЧКИ (SwipeCardView Plugin) -->
            <Grid Grid.Row="1" Padding="20,10,20,20">
                <swipeCardView:SwipeCardView
                    x:Name="CardSwipeView"
                    ItemsSource="{Binding Queue}"
                    TopItem="{Binding CurrentCard}"
                    SwipedCommand="{Binding CardSwipedCommand}"
                    SupportedSwipeDirections="Left, Right"
                    SupportedDraggingDirections="Left, Right"
                    StackDepth="2"
                    StackOffset="12"
                    StackScaleStep="0.04"
                    AnimationLength="250"
                    BackCardScale="0.95"
                    CardRotation="15">

                    <swipeCardView:SwipeCardView.ItemTemplate>
                        <DataTemplate x:DataType="local:StudyCardItem">
                            <!-- Фиксируем размер карточки, чтобы она не "прыгала" при открытии контента -->
                            <Border BackgroundColor="White" StrokeThickness="0" 
                                    HorizontalOptions="Fill" VerticalOptions="Fill">
                                <Border.StrokeShape><RoundRectangle CornerRadius="24" /></Border.StrokeShape>
                                <Border.Shadow><Shadow Brush="Black" Offset="0,8" Radius="16" Opacity="0.1" /></Border.Shadow>

                                <!-- Разбиваем карту на: Шапку (Auto), Контент со скроллом (*), Кнопки (Auto, Auto) -->
                                <Grid RowDefinitions="Auto, *, Auto, Auto" IsVisible="{Binding IsTopCard}">

                                    <!-- ВЕРХНЯЯ ЧАСТЬ: Заголовок и вопрос (Безопасная зона для свайпа) -->
                                    <VerticalStackLayout Grid.Row="0" Margin="24,12,24,0" Spacing="16" InputTransparent="True">

                                        <!-- Визуальный маркер-ручка для свайпа (Drag handle) -->
                                        <BoxView HeightRequest="5" 
                                            WidthRequest="40" 
                                            Color="#D1D1D6" 
                                            CornerRadius="2.5" 
                                            HorizontalOptions="Center" 
                                            Margin="0,0,0,8"/>

                                        <Label Text="{Binding DomainCard.Title}" FontSize="24" FontAttributes="Bold" TextColor="#1C1C1E" />
                                        <controls:MarkdownView Text="{Binding DomainCard.FrontMarkdown}" TextColor="#2C2C2E" />
                                        <BoxView HeightRequest="1" Color="#F2F2F6" IsVisible="{Binding IsBriefVisible}" />
                                    </VerticalStackLayout>

                                    <!-- СРЕДНЯЯ ЧАСТЬ: Ответы со скроллом -->
                                    <Grid Grid.Row="1" Margin="24,8,24,0" RowDefinitions="Auto, *">

                                        <!-- ПЕРЕКЛЮЧАТЕЛЬ СКРОЛЛА (Появляется при открытии полного ответа) -->
                                        <Border Grid.Row="0" IsVisible="{Binding IsDetailedVisible}" 
                                                BackgroundColor="#F4F5F8" StrokeThickness="0" 
                                                HorizontalOptions="End" Padding="12,6" Margin="0,0,0,8">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding BindingContext.ToggleScrollCommand, Source={x:Reference SessionPage}}" CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Label FontSize="12" FontAttributes="Bold" TextColor="#6278E6">
                                                <Label.Triggers>
                                                    <!-- По умолчанию скролл выключен, работает свайп за центр -->
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsScrollEnabled}" Value="False">
                                                        <Setter Property="Text" Value="🔓 Разблокировать скролл" />
                                                    </DataTrigger>
                                                    <!-- Включен скролл, свайп за центр не работает -->
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsScrollEnabled}" Value="True">
                                                        <Setter Property="Text" Value="🔒 Вернуть свайп" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </Border>

                                        <!-- СКРОЛЛ (Блокируется по умолчанию через InvertedBoolConverter) -->
                                        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Always"
                                                    InputTransparent="{Binding IsScrollEnabled, Converter={toolkit:InvertedBoolConverter}}">
                                            <VerticalStackLayout Spacing="16">

                                                <VerticalStackLayout IsVisible="{Binding IsBriefVisible}" Spacing="8">
                                                    <Label Text="КРАТКИЙ ОТВЕТ" FontSize="11" TextColor="#8E8E93" FontAttributes="Bold" />
                                                    <controls:MarkdownView Text="{Binding DomainCard.BriefMarkdown}" TextColor="#2C2C2E" InputTransparent="True" />
                                                </VerticalStackLayout>

                                                <ActivityIndicator IsRunning="{Binding IsLoadingDetailed}" IsVisible="{Binding IsLoadingDetailed}" Color="#6278E6" HorizontalOptions="Center" Margin="0,10,0,0" />

                                                <BoxView HeightRequest="1" Color="#F2F2F6" IsVisible="{Binding IsDetailedVisible}" />

                                                <VerticalStackLayout IsVisible="{Binding IsDetailedVisible}" Spacing="8" Padding="0,0,0,24">
                                                    <Label Text="ПОДРОБНЫЙ ОТВЕТ" FontSize="11" TextColor="#8E8E93" FontAttributes="Bold" />
                                                    <controls:MarkdownView Text="{Binding DomainCard.DetailedMarkdown}" TextColor="#2C2C2E" InputTransparent="True" />
                                                </VerticalStackLayout>

                                            </VerticalStackLayout>
                                        </ScrollView>
                                    </Grid>

                                    <!-- КНОПКА ПОКАЗА ОТВЕТА (Прячется, когда открыт полный ответ) -->
                                    <Border Grid.Row="2" BackgroundColor="#F4F5F8" StrokeThickness="0" Margin="16,0,16,16" Padding="16">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>

                                        <!-- Убраны CommandParameter (ViewModel сама берет CurrentCard) -->
                                        <Border.Behaviors>
                                            <toolkit:TouchBehavior DefaultBackgroundColor="#F4F5F8" PressedBackgroundColor="#EAECEF"
                                                                   Command="{Binding BindingContext.RevealBriefCommand, Source={x:Reference SessionPage}}" 
                                                                   LongPressCommand="{Binding BindingContext.RevealDetailedCommand, Source={x:Reference SessionPage}}" />
                                        </Border.Behaviors>

                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsDetailedVisible}" Value="True">
                                                <Setter Property="IsVisible" Value="False" />
                                            </DataTrigger>
                                        </Border.Triggers>

                                        <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8" InputTransparent="True">
                                            <Grid WidthRequest="20" HeightRequest="20">
                                                <Image Source="{mi:Material Icon=Visibility, IconColor=#8E8E93}" IsVisible="True">
                                                    <Image.Triggers><DataTrigger TargetType="Image" Binding="{Binding IsBriefVisible}" Value="True"><Setter Property="IsVisible" Value="False" /></DataTrigger></Image.Triggers>
                                                </Image>
                                                <Image Source="{mi:Material Icon=MoreHoriz, IconColor=#8E8E93}" IsVisible="False">
                                                    <Image.Triggers><DataTrigger TargetType="Image" Binding="{Binding IsBriefVisible}" Value="True"><Setter Property="IsVisible" Value="True" /></DataTrigger></Image.Triggers>
                                                </Image>
                                            </Grid>
                                            <Label FontSize="14" FontAttributes="Bold" TextColor="#8E8E93" VerticalOptions="Center">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsBriefVisible}" Value="False"><Setter Property="Text" Value="Показать ответ" /></DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsBriefVisible}" Value="True"><Setter Property="Text" Value="Зажмите для подробностей" /></DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </HorizontalStackLayout>
                                    </Border>

                                    <!-- НИЖНЯЯ ПАНЕЛЬ С КНОПКАМИ СВАЙПА -->
                                    <Grid Grid.Row="3" ColumnDefinitions="*, 1, *" HeightRequest="64" BackgroundColor="#F4F5F8">

                                        <Border Grid.Column="0" BackgroundColor="Transparent" StrokeThickness="0">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnSwipeLeftClicked" />
                                            </Border.GestureRecognizers>
                                            <Label HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold" FontSize="16">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding Phase}" Value="Discovery">
                                                        <Setter Property="Text" Value="Уже знаю" />
                                                        <Setter Property="TextColor" Value="#8E8E93" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding Phase}" Value="Review">
                                                        <Setter Property="Text" Value="Отложить" />
                                                        <Setter Property="TextColor" Value="#FF3B30" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </Border>

                                        <!-- Перегородка -->
                                        <BoxView Grid.Column="1" Color="#EAECEF" Margin="0,16" />

                                        <Border Grid.Column="2" BackgroundColor="Transparent" StrokeThickness="0">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnSwipeRightClicked" />
                                            </Border.GestureRecognizers>
                                            <Label HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold" FontSize="16">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding Phase}" Value="Discovery">
                                                        <Setter Property="Text" Value="Учить" />
                                                        <Setter Property="TextColor" Value="#1C1C1E" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding Phase}" Value="Review">
                                                        <Setter Property="Text" Value="Вспомнил" />
                                                        <Setter Property="TextColor" Value="#34C759" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </Border>
                                    </Grid>

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </swipeCardView:SwipeCardView.ItemTemplate>

                </swipeCardView:SwipeCardView>
            </Grid>

            <!-- СКРЫТОЕ МЕНЮ (Выдвижное сбоку) -->
            <Grid Grid.Row="2" ColumnDefinitions="*, Auto" IsVisible="{Binding IsHiddenMenuVisible}">
                <BoxView Grid.Column="0" Color="Black" Opacity="0.3" />
                <VerticalStackLayout Grid.Column="1" WidthRequest="250" BackgroundColor="White">
                    <Button Text="Откатить на 1 стадию" Command="{Binding RollbackProgressCommand}" BackgroundColor="Transparent" TextColor="#1C1C1E" HorizontalOptions="Start" Padding="16" />
                    <BoxView HeightRequest="1" Color="#EAECEF" />
                    <Button Text="Обнулить прогресс слова" Command="{Binding ResetProgressCommand}" BackgroundColor="Transparent" TextColor="#FF9500" HorizontalOptions="Start" Padding="16" />
                    <BoxView HeightRequest="1" Color="#EAECEF" />
                    <Button Text="Удалить карточку" Command="{Binding DeleteCardCommand}" BackgroundColor="Transparent" TextColor="#FF3B30" HorizontalOptions="Start" Padding="16" />
                </VerticalStackLayout>
            </Grid>

        </Grid>
    </Grid>
</ContentPage>
