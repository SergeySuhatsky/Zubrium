<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Zubrium.Maui.Views.Controls"
             xmlns:local="clr-namespace:Zubrium.Maui.Features.Study"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             x:Class="Zubrium.Maui.Features.Study.StudySessionPage"
             x:DataType="local:StudySessionViewModel"
             BackgroundColor="#F4F5F8">

    <Grid>
        <!-- ОСНОВНОЙ КОНТЕНТ (Когда карточки есть) -->
        <Grid RowDefinitions="Auto, *, Auto" IsVisible="{Binding HasCards}">

            <!-- Шапка -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Padding="20" BackgroundColor="White">
                <controls:DesktopBackButton Grid.Column="0" />

                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" HorizontalOptions="Center" Spacing="2">
                    <Label Text="{Binding CardsLeft, StringFormat='Осталось: {0}'}" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center"/>
                    <!-- Вывод прогноза: через сколько карточка появится -->
                    <Label Text="{Binding CurrentCard.DomainCard.NextReviewText, StringFormat='Следующее появление: {0}'}" FontSize="12" TextColor="#8E8E93" HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <!-- Кнопка скрытого меню -->
                <ImageButton Grid.Column="2" Source="{mi:Material Icon=MoreVert, IconColor=Black}" 
                             WidthRequest="32" HeightRequest="32" 
                             Command="{Binding ToggleHiddenMenuCommand}" />
            </Grid>

            <!-- Карточка -->
            <ScrollView Grid.Row="1" Margin="20">
                <Border BackgroundColor="White" Stroke="#EAECEF" StrokeThickness="1" Padding="24">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,4" Radius="15" Opacity="0.05" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="16">
                        <!-- Лицевая сторона -->
                        <Label Text="ЛИЦЕВАЯ СТОРОНА" FontSize="11" TextColor="#8E8E93" FontAttributes="Bold" />
                        <controls:MarkdownView Text="{Binding CurrentCard.DomainCard.FrontMarkdown}" BaseFontSize="18" />

                        <!-- Оборотная сторона (видна только если перевернуто) -->
                        <VerticalStackLayout IsVisible="{Binding CurrentCard.IsFlipped}" Spacing="16">
                            <BoxView HeightRequest="1" Color="#EAECEF" />
                            <Label Text="ОТВЕТ" FontSize="11" TextColor="#8E8E93" FontAttributes="Bold" />
                            <controls:MarkdownView Text="{Binding CurrentCard.DomainCard.BriefMarkdown}" BaseFontSize="16" />

                            <!-- Detailed (Опционально) -->
                            <VerticalStackLayout>
                                <VerticalStackLayout.Triggers>
                                    <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding CurrentCard.DomainCard.DetailedMarkdown}" Value="{x:Null}">
                                        <Setter Property="IsVisible" Value="False" />
                                    </DataTrigger>
                                </VerticalStackLayout.Triggers>
                                <BoxView HeightRequest="1" Color="#EAECEF" Margin="0,8"/>
                                <Label Text="ПОДРОБНО" FontSize="11" TextColor="#8E8E93" FontAttributes="Bold" />
                                <controls:MarkdownView Text="{Binding CurrentCard.DomainCard.DetailedMarkdown}" BaseFontSize="14" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </ScrollView>

            <!-- ОРГАНЫ УПРАВЛЕНИЯ (КНОПКИ ТЕСТИРОВАНИЯ ВМЕСТО СВАЙПОВ) -->
            <Grid Grid.Row="2" Padding="20,10,20,40" BackgroundColor="White">

                <!-- Кнопки для фазы 0: Знакомство -->
                <Grid ColumnDefinitions="*, *" ColumnSpacing="16">
                    <Grid.Triggers>
                        <DataTrigger TargetType="Grid" Binding="{Binding CurrentCard.Phase}" Value="Review">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                    </Grid.Triggers>

                    <Button Grid.Column="0" Text="← Знаю" Command="{Binding MarkAsKnownCommand}" BackgroundColor="#34C759" TextColor="White" FontAttributes="Bold" HeightRequest="56" CornerRadius="12" />
                    <Button Grid.Column="1" Text="Учить →" Command="{Binding StartLearningCommand}" BackgroundColor="#6278E6" TextColor="White" FontAttributes="Bold" HeightRequest="56" CornerRadius="12" />
                </Grid>

                <!-- Кнопки для фазы 1: Изучение (До переворота) -->
                <Button Text="Показать ответ" Command="{Binding FlipCardCommand}" BackgroundColor="#1C1C1E" TextColor="White" FontAttributes="Bold" HeightRequest="56" CornerRadius="12">
                    <Button.Triggers>
                        <!-- Прячем, если мы не на фазе Review или карточка уже перевернута -->
                        <DataTrigger TargetType="Button" Binding="{Binding CurrentCard.Phase}" Value="Discovery">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                        <DataTrigger TargetType="Button" Binding="{Binding CurrentCard.IsFlipped}" Value="True">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

                <!-- Кнопки для фазы 1: Изучение (После переворота) -->
                <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, *" RowSpacing="12" ColumnSpacing="12">
                    <Grid.Triggers>
                        <DataTrigger TargetType="Grid" Binding="{Binding CurrentCard.Phase}" Value="Discovery">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                        <DataTrigger TargetType="Grid" Binding="{Binding CurrentCard.IsFlipped}" Value="False">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                    </Grid.Triggers>

                    <Button Grid.Row="0" Grid.Column="0" Text="↑ Hard (Spinner)" Command="{Binding RateHardCommand}" BackgroundColor="#FF9500" TextColor="White" FontAttributes="Bold" HeightRequest="48" CornerRadius="12"/>
                    <Button Grid.Row="0" Grid.Column="1" Text="↓ Easy (Spinner)" Command="{Binding RateEasyCommand}" BackgroundColor="#34C759" TextColor="White" FontAttributes="Bold" HeightRequest="48" CornerRadius="12"/>
                    <Button Grid.Row="1" Grid.Column="0" Text="← Good" Command="{Binding RateGoodCommand}" BackgroundColor="#6278E6" TextColor="White" FontAttributes="Bold" HeightRequest="56" CornerRadius="12"/>
                    <Button Grid.Row="1" Grid.Column="1" Text="Еще раз →" Command="{Binding ShowAgainInSessionCommand}" BackgroundColor="#EAECEF" TextColor="#1C1C1E" FontAttributes="Bold" HeightRequest="56" CornerRadius="12"/>
                </Grid>

            </Grid>
        </Grid>

        <!-- ЭКРАН ЗАВЕРШЕНИЯ -->
        <VerticalStackLayout IsVisible="{Binding IsSessionFinished}" VerticalOptions="Center" HorizontalOptions="Center" Spacing="20">
            <Label Text="Сессия завершена!" FontSize="24" FontAttributes="Bold" TextColor="#1C1C1E" HorizontalOptions="Center"/>
            <Label Text="Вы прошли все карточки в очереди." TextColor="#8E8E93" HorizontalOptions="Center"/>
            <Button Text="Вернуться" Command="{Binding FinishSessionCommand}" BackgroundColor="#6278E6" TextColor="White" FontAttributes="Bold" WidthRequest="200" HeightRequest="48" CornerRadius="12" />
        </VerticalStackLayout>

        <!-- СКРЫТОЕ МЕНЮ (OVERLAY) -->
        <Grid BackgroundColor="#80000000" IsVisible="{Binding IsHiddenMenuVisible}">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding ToggleHiddenMenuCommand}" />
            </Grid.GestureRecognizers>

            <Border BackgroundColor="White" VerticalOptions="Start" HorizontalOptions="End" Margin="20,70,20,0" Padding="0" StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,4" Radius="10" Opacity="0.1" />
                </Border.Shadow>
                <VerticalStackLayout WidthRequest="250">
                    <Button Text="Показывать чаще (Again)" Command="{Binding RateAgainCommand}" BackgroundColor="Transparent" TextColor="#1C1C1E" HorizontalOptions="Start" Padding="16" />
                    <BoxView HeightRequest="1" Color="#EAECEF" />
                    <Button Text="Обнулить прогресс карточки" Command="{Binding ResetProgressCommand}" BackgroundColor="Transparent" TextColor="#FF3B30" HorizontalOptions="Start" Padding="16" />
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>
