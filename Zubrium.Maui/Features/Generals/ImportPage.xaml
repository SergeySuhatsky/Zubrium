<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:controls="clr-namespace:Zubrium.Maui.Views.Controls"
             xmlns:local="clr-namespace:Zubrium.Maui.Features.Generals"
             xmlns:domain="clr-namespace:Zubrium.Domain"
             x:Class="Zubrium.Maui.Features.Generals.ImportPage"
             x:DataType="local:ImportViewModel"
             BackgroundColor="#F4F5F8">

    
    <Grid RowDefinitions="*, Auto">
        
        
        <!-- Основной контент со скроллом -->
        <ScrollView Grid.Row="0" x:Name="MainScrollView" Scrolled="OnScrollViewScrolled" VerticalScrollBarVisibility="Always">

            <VerticalStackLayout Padding="20,10,20,40" Spacing="0">

                <Grid Margin="0,0,0,24">
                    <controls:DesktopBackButton />
                    <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">
                        <Label Text="Добавить контент" FontSize="20" FontAttributes="Bold" TextColor="#1C1C1E" VerticalOptions="Center"/>
                        <ImageButton Source="{mi:Material Icon=HelpOutline, IconColor=#8E8E93}" 
                                     WidthRequest="24" HeightRequest="24" 
                                     BackgroundColor="Transparent"
                                     VerticalOptions="Center" 
                                     Command="{Binding TogglePromptOverlayCommand}"/>
                    </HorizontalStackLayout>
                </Grid>

                <!-- Вкладки: Вставить текст / Файл -->
                <Grid ColumnDefinitions="*, *" ColumnSpacing="12" Margin="0,0,0,24">
                    <!-- Вкладка "Вставить текст" -->
                    <Border Grid.Column="0" StrokeThickness="1" Padding="0,12">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SwitchToPasteTextCommand}" />
                        </Border.GestureRecognizers>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsPasteTextMode}" Value="True">
                                <Setter Property="BackgroundColor" Value="#1C1C1E" />
                                <Setter Property="Stroke" Value="#1C1C1E" />
                            </DataTrigger>
                            <DataTrigger TargetType="Border" Binding="{Binding IsPasteTextMode}" Value="False">
                                <Setter Property="BackgroundColor" Value="White" />
                                <Setter Property="Stroke" Value="#EAECEF" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Label Text="Вставить текст" HorizontalOptions="Center" FontAttributes="Bold">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsPasteTextMode}" Value="True">
                                    <Setter Property="TextColor" Value="White" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding IsPasteTextMode}" Value="False">
                                    <Setter Property="TextColor" Value="#1C1C1E" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Border>

                    <!-- Вкладка "Файл с устройства" -->
                    <Border Grid.Column="1" StrokeThickness="1" Padding="0,12">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SwitchToFileCommand}" />
                        </Border.GestureRecognizers>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsFileMode}" Value="True">
                                <Setter Property="BackgroundColor" Value="#1C1C1E" />
                                <Setter Property="Stroke" Value="#1C1C1E" />
                            </DataTrigger>
                            <DataTrigger TargetType="Border" Binding="{Binding IsFileMode}" Value="False">
                                <Setter Property="BackgroundColor" Value="White" />
                                <Setter Property="Stroke" Value="#EAECEF" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Label Text="Файл с устройства" HorizontalOptions="Center" FontAttributes="Bold">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsFileMode}" Value="True">
                                    <Setter Property="TextColor" Value="White" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding IsFileMode}" Value="False">
                                    <Setter Property="TextColor" Value="#1C1C1E" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Border>
                </Grid>

                <!-- Контент для режима "Вставить текст" -->
                <VerticalStackLayout IsVisible="{Binding IsPasteTextMode}" Spacing="12" Margin="0,0,0,24">
                    <!-- Кнопка предпросмотра блокируется (IsEnabled), если нет контента (HasContent = false) -->
                    <!-- Кнопка "Посмотреть код контента" -->
                    <!-- Кнопка "Посмотреть код контента" -->
                    <Border StrokeThickness="1" 
                        HeightRequest="48"
                        IsEnabled="{Binding HasContent}">
                        
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenCodePreviewCommand}" />
                        </Border.GestureRecognizers>

                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding HasContent}" Value="True">
                                <Setter Property="BackgroundColor" Value="#1C1C1E" />
                                <Setter Property="Stroke" Value="#1C1C1E" />
                            </DataTrigger>
                            <DataTrigger TargetType="Border" Binding="{Binding HasContent}" Value="False">
                                <Setter Property="BackgroundColor" Value="#E0E0E0" />
                                <Setter Property="Stroke" Value="#E0E0E0" />
                                <Setter Property="Opacity" Value="0.5" />
                            </DataTrigger>
                        </Border.Triggers>

                        <!-- Контейнер для центрирования иконки и текста -->
                        <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">

                            <!-- Grid накладывает иконки друг на друга -->
                            <Grid>
                                <!-- Иконка для состояния HasContent = True (Белая) -->
                                <Image Source="{mi:Material Icon=Code, IconColor=White}" WidthRequest="24" HeightRequest="24" IsVisible="False">
                                    <Image.Triggers>
                                        <DataTrigger TargetType="Image" Binding="{Binding HasContent}" Value="True">
                                            <Setter Property="IsVisible" Value="True" />
                                        </DataTrigger>
                                    </Image.Triggers>
                                </Image>

                                <!-- Иконка для состояния HasContent = False (Черная) -->
                                <Image Source="{mi:Material Icon=Code, IconColor=Black}" WidthRequest="24" HeightRequest="24" IsVisible="True">
                                    <Image.Triggers>
                                        <DataTrigger TargetType="Image" Binding="{Binding HasContent}" Value="True">
                                            <Setter Property="IsVisible" Value="False" />
                                        </DataTrigger>
                                    </Image.Triggers>
                                </Image>
                            </Grid>

                            <!-- Текст -->
                            <Label Text="Посмотреть код контента" 
                                VerticalOptions="Center"
                                FontAttributes="Bold">
                                
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding HasContent}" Value="True">
                                        <Setter Property="TextColor" Value="White" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding HasContent}" Value="False">
                                        <Setter Property="TextColor" Value="Black" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Кнопка "Вставить из буфера обмена" -->
                    <Border StrokeThickness="0" 
                            HeightRequest="48"
                            BackgroundColor="#6278E6">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding PasteFromClipboardCommand}" />
                        </Border.GestureRecognizers>

                        <!-- Контейнер для центрирования иконки и текста -->
                        <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">

                            <!-- Одна иконка, так как состояние кнопки не меняется -->
                            <Image Source="{mi:Material Icon=ContentPaste, IconColor=White}" WidthRequest="24" HeightRequest="24" />

                            <!-- Текст -->
                            <Label Text="Вставить из буфера обмена" 
                                VerticalOptions="Center"
                                TextColor="White" 
                                FontAttributes="Bold" />
                        </HorizontalStackLayout>
                    </Border>


                </VerticalStackLayout>

                <!-- Контент для режима "Файл с устройства" -->
                <VerticalStackLayout IsVisible="{Binding IsFileMode}" Spacing="12" Margin="0,0,0,24">
                    <!-- Кнопка "Посмотреть код контента" для режима ФАЙЛ -->
                    <Border StrokeThickness="1" 
                        HeightRequest="48"
                        IsEnabled="{Binding HasContent}">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenCodePreviewCommand}" />
                        </Border.GestureRecognizers>

                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding HasContent}" Value="True">
                                <Setter Property="BackgroundColor" Value="#1C1C1E" />
                                <Setter Property="Stroke" Value="#1C1C1E" />
                            </DataTrigger>
                            <DataTrigger TargetType="Border" Binding="{Binding HasContent}" Value="False">
                                <Setter Property="BackgroundColor" Value="#E0E0E0" />
                                <Setter Property="Stroke" Value="#E0E0E0" />
                            </DataTrigger>
                        </Border.Triggers>
                        <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">
                            <Image Source="{mi:Material Icon=Code, IconColor=White}" WidthRequest="24" HeightRequest="24" IsVisible="False">
                                <Image.Triggers>
                                    <DataTrigger TargetType="Image" Binding="{Binding HasContent}" Value="True">
                                        <Setter Property="IsVisible" Value="True" />
                                    </DataTrigger>
                                </Image.Triggers>
                            </Image>
                            <Image Source="{mi:Material Icon=Code, IconColor=#8E8E93}" WidthRequest="24" HeightRequest="24" IsVisible="True">
                                <Image.Triggers>
                                    <DataTrigger TargetType="Image" Binding="{Binding HasContent}" Value="True">
                                        <Setter Property="IsVisible" Value="False" />
                                    </DataTrigger>
                                </Image.Triggers>
                            </Image>
                            <Label Text="Посмотреть код контента" 
                                VerticalOptions="Center"
                                FontAttributes="Bold">

                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding HasContent}" Value="True">
                                        <Setter Property="TextColor" Value="White" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding HasContent}" Value="False">
                                        <Setter Property="TextColor" Value="Black" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </HorizontalStackLayout>
                    </Border>

                    <Button Text="Выбрать файл" 
                            BackgroundColor="#6278E6" 
                            TextColor="White" 
                            FontAttributes="Bold" 
                            HeightRequest="48"
                            CornerRadius="12"
                            Command="{Binding PickFileCommand}" />
                </VerticalStackLayout>

                <!-- Выбор категории -->
                <Label Text="КАТЕГОРИЯ" FontSize="13" TextColor="#9595A5" FontAttributes="Bold" Margin="4,0,0,8" />
                <Border BackgroundColor="White" Stroke="#EAECEF" StrokeThickness="1" Padding="16,14" Margin="0,0,0,24">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        
                        <Label Grid.Column="1" Text="{Binding SelectedCategoryText}" TextColor="#1C1C1E" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />
                        <Image Grid.Column="2" Source="{mi:Material Icon=KeyboardArrowDown, IconColor=#8E8E93}" WidthRequest="24" HeightRequest="24" VerticalOptions="Center" />
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectCategoryCommand}" />
                    </Border.GestureRecognizers>
                </Border>

                <!-- Что импортировать -->
                <Label Text="ЧТО ИМПОРТИРОВАТЬ" FontSize="13" TextColor="#9595A5" FontAttributes="Bold" Margin="4,0,0,8" />
                <VerticalStackLayout Spacing="10" Margin="0,0,0,24">

                    <!-- Карточка 1: Карточки -->
                    <Border StrokeThickness="1" Padding="16" IsEnabled="{Binding HasCards}" Opacity="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleCardsImportCommand}" />
                        </Border.GestureRecognizers>
                        <Border.Triggers>
                            <!-- Активна и выбрана -->
                            <DataTrigger TargetType="Border" Binding="{Binding IsCardsImportSelected}" Value="True">
                                <Setter Property="BackgroundColor" Value="#6278E6" />
                                <Setter Property="Stroke" Value="#6278E6" />
                            </DataTrigger>
                            <!-- Активна, но не выбрана -->
                            <MultiTrigger TargetType="Border">
                                <MultiTrigger.Conditions>
                                    <BindingCondition Binding="{Binding IsCardsImportSelected}" Value="False" />
                                    <BindingCondition Binding="{Binding HasCards}" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter Property="BackgroundColor" Value="White" />
                                <Setter Property="Stroke" Value="#EAECEF" />
                            </MultiTrigger>
                            <!-- Неактивна (нет элементов) -->
                            <DataTrigger TargetType="Border" Binding="{Binding HasCards}" Value="False">
                                <Setter Property="BackgroundColor" Value="#F5F5F5" />
                                <Setter Property="Stroke" Value="#E0E0E0" />
                                <Setter Property="Opacity" Value="0.6" />
                            </DataTrigger>
                        </Border.Triggers>

                        <Grid ColumnDefinitions="Auto, *">
                            <Grid Grid.Column="0" VerticalOptions="Center" Margin="0,0,16,0">
                                <Image Source="{mi:Material Icon=Style, IconColor=White}" WidthRequest="28" HeightRequest="28" IsVisible="False">
                                    <Image.Triggers>
                                        <DataTrigger TargetType="Image" Binding="{Binding IsCardsImportSelected}" Value="True">
                                            <Setter Property="IsVisible" Value="True" />
                                        </DataTrigger>
                                    </Image.Triggers>
                                </Image>
                                <Image Source="{mi:Material Icon=Style, IconColor=#8E8E93}" WidthRequest="28" HeightRequest="28" IsVisible="True">
                                    <Image.Triggers>
                                        <DataTrigger TargetType="Image" Binding="{Binding IsCardsImportSelected}" Value="True">
                                            <Setter Property="IsVisible" Value="False" />
                                        </DataTrigger>
                                    </Image.Triggers>
                                </Image>
                            </Grid>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="Карточки" FontSize="16" FontAttributes="Bold">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsCardsImportSelected}" Value="True">
                                            <Setter Property="TextColor" Value="White" />
                                        </DataTrigger>
                                        <MultiTrigger TargetType="Label">
                                            <MultiTrigger.Conditions>
                                                <BindingCondition Binding="{Binding IsCardsImportSelected}" Value="False" />
                                                <BindingCondition Binding="{Binding HasCards}" Value="True" />
                                            </MultiTrigger.Conditions>
                                            <Setter Property="TextColor" Value="#1C1C1E" />
                                        </MultiTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding HasCards}" Value="False">
                                            <Setter Property="TextColor" Value="#9E9E9E" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Label Text="{Binding CardsFoundCount, StringFormat='Найдено: {0}'}" FontSize="13">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsCardsImportSelected}" Value="True">
                                            <Setter Property="TextColor" Value="#E0E6FF" />
                                        </DataTrigger>
                                        <MultiTrigger TargetType="Label">
                                            <MultiTrigger.Conditions>
                                                <BindingCondition Binding="{Binding IsCardsImportSelected}" Value="False" />
                                                <BindingCondition Binding="{Binding HasCards}" Value="True" />
                                            </MultiTrigger.Conditions>
                                            <Setter Property="TextColor" Value="#8E8E93" />
                                        </MultiTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding HasCards}" Value="False">
                                            <Setter Property="TextColor" Value="#B0B0B0" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Карточка 2: Квизы -->
                    <Border StrokeThickness="1" Padding="16" IsEnabled="{Binding HasQuizzes}" Opacity="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleQuizzesImportCommand}" />
                        </Border.GestureRecognizers>
                        <Border.Triggers>
                            <!-- Активна и выбрана -->
                            <DataTrigger TargetType="Border" Binding="{Binding IsQuizzesImportSelected}" Value="True">
                                <Setter Property="BackgroundColor" Value="#6278E6" />
                                <Setter Property="Stroke" Value="#6278E6" />
                            </DataTrigger>
                            <!-- Активна, но не выбрана -->
                            <MultiTrigger TargetType="Border">
                                <MultiTrigger.Conditions>
                                    <BindingCondition Binding="{Binding IsQuizzesImportSelected}" Value="False" />
                                    <BindingCondition Binding="{Binding HasQuizzes}" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter Property="BackgroundColor" Value="White" />
                                <Setter Property="Stroke" Value="#EAECEF" />
                            </MultiTrigger>
                            <!-- Неактивна (нет элементов) -->
                            <DataTrigger TargetType="Border" Binding="{Binding HasQuizzes}" Value="False">
                                <Setter Property="BackgroundColor" Value="#F5F5F5" />
                                <Setter Property="Stroke" Value="#E0E0E0" />
                                <Setter Property="Opacity" Value="0.6" />
                            </DataTrigger>
                        </Border.Triggers>

                        <Grid ColumnDefinitions="Auto, *">
                            <Grid Grid.Column="0" VerticalOptions="Center" Margin="0,0,16,0">
                                <Image Source="{mi:Material Icon=Science, IconColor=White}" WidthRequest="28" HeightRequest="28" IsVisible="False">
                                    <Image.Triggers>
                                        <DataTrigger TargetType="Image" Binding="{Binding IsQuizzesImportSelected}" Value="True">
                                            <Setter Property="IsVisible" Value="True" />
                                        </DataTrigger>
                                    </Image.Triggers>
                                </Image>
                                <Image Source="{mi:Material Icon=Science, IconColor=#8E8E93}" WidthRequest="28" HeightRequest="28" IsVisible="True">
                                    <Image.Triggers>
                                        <DataTrigger TargetType="Image" Binding="{Binding IsQuizzesImportSelected}" Value="True">
                                            <Setter Property="IsVisible" Value="False" />
                                        </DataTrigger>
                                    </Image.Triggers>
                                </Image>
                            </Grid>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="Квизы" FontSize="16" FontAttributes="Bold">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsQuizzesImportSelected}" Value="True">
                                            <Setter Property="TextColor" Value="White" />
                                        </DataTrigger>
                                        <MultiTrigger TargetType="Label">
                                            <MultiTrigger.Conditions>
                                                <BindingCondition Binding="{Binding IsQuizzesImportSelected}" Value="False" />
                                                <BindingCondition Binding="{Binding HasQuizzes}" Value="True" />
                                            </MultiTrigger.Conditions>
                                            <Setter Property="TextColor" Value="#1C1C1E" />
                                        </MultiTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding HasQuizzes}" Value="False">
                                            <Setter Property="TextColor" Value="#9E9E9E" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Label Text="{Binding QuizzesFoundCount, StringFormat='Найдено: {0}'}" FontSize="13">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsQuizzesImportSelected}" Value="True">
                                            <Setter Property="TextColor" Value="#E0E6FF" />
                                        </DataTrigger>
                                        <MultiTrigger TargetType="Label">
                                            <MultiTrigger.Conditions>
                                                <BindingCondition Binding="{Binding IsQuizzesImportSelected}" Value="False" />
                                                <BindingCondition Binding="{Binding HasQuizzes}" Value="True" />
                                            </MultiTrigger.Conditions>
                                            <Setter Property="TextColor" Value="#8E8E93" />
                                        </MultiTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding HasQuizzes}" Value="False">
                                            <Setter Property="TextColor" Value="#B0B0B0" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Карточка 3: Статьи -->
                    <Border StrokeThickness="1" Padding="16" IsEnabled="{Binding HasArticles}" Opacity="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleArticlesImportCommand}" />
                        </Border.GestureRecognizers>
                        <Border.Triggers>
                            <!-- Активна и выбрана -->
                            <DataTrigger TargetType="Border" Binding="{Binding IsArticlesImportSelected}" Value="True">
                                <Setter Property="BackgroundColor" Value="#6278E6" />
                                <Setter Property="Stroke" Value="#6278E6" />
                            </DataTrigger>
                            <!-- Активна, но не выбрана -->
                            <MultiTrigger TargetType="Border">
                                <MultiTrigger.Conditions>
                                    <BindingCondition Binding="{Binding IsArticlesImportSelected}" Value="False" />
                                    <BindingCondition Binding="{Binding HasArticles}" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter Property="BackgroundColor" Value="White" />
                                <Setter Property="Stroke" Value="#EAECEF" />
                            </MultiTrigger>
                            <!-- Неактивна (нет элементов) -->
                            <DataTrigger TargetType="Border" Binding="{Binding HasArticles}" Value="False">
                                <Setter Property="BackgroundColor" Value="#F5F5F5" />
                                <Setter Property="Stroke" Value="#E0E0E0" />
                                <Setter Property="Opacity" Value="0.6" />
                            </DataTrigger>
                        </Border.Triggers>

                        <Grid ColumnDefinitions="Auto, *">
                            <Grid Grid.Column="0" VerticalOptions="Center" Margin="0,0,16,0">
                                <Image Source="{mi:Material Icon=Article, IconColor=White}" WidthRequest="28" HeightRequest="28" IsVisible="False">
                                    <Image.Triggers>
                                        <DataTrigger TargetType="Image" Binding="{Binding IsArticlesImportSelected}" Value="True">
                                            <Setter Property="IsVisible" Value="True" />
                                        </DataTrigger>
                                    </Image.Triggers>
                                </Image>
                                <Image Source="{mi:Material Icon=Article, IconColor=#8E8E93}" WidthRequest="28" HeightRequest="28" IsVisible="True">
                                    <Image.Triggers>
                                        <DataTrigger TargetType="Image" Binding="{Binding IsArticlesImportSelected}" Value="True">
                                            <Setter Property="IsVisible" Value="False" />
                                        </DataTrigger>
                                    </Image.Triggers>
                                </Image>
                            </Grid>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="Статьи" FontSize="16" FontAttributes="Bold">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsArticlesImportSelected}" Value="True">
                                            <Setter Property="TextColor" Value="White" />
                                        </DataTrigger>
                                        <MultiTrigger TargetType="Label">
                                            <MultiTrigger.Conditions>
                                                <BindingCondition Binding="{Binding IsArticlesImportSelected}" Value="False" />
                                                <BindingCondition Binding="{Binding HasArticles}" Value="True" />
                                            </MultiTrigger.Conditions>
                                            <Setter Property="TextColor" Value="#1C1C1E" />
                                        </MultiTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding HasArticles}" Value="False">
                                            <Setter Property="TextColor" Value="#9E9E9E" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Label Text="{Binding ArticlesFoundCount, StringFormat='Найдено: {0}'}" FontSize="13">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsArticlesImportSelected}" Value="True">
                                            <Setter Property="TextColor" Value="#E0E6FF" />
                                        </DataTrigger>
                                        <MultiTrigger TargetType="Label">
                                            <MultiTrigger.Conditions>
                                                <BindingCondition Binding="{Binding IsArticlesImportSelected}" Value="False" />
                                                <BindingCondition Binding="{Binding HasArticles}" Value="True" />
                                            </MultiTrigger.Conditions>
                                            <Setter Property="TextColor" Value="#8E8E93" />
                                        </MultiTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding HasArticles}" Value="False">
                                            <Setter Property="TextColor" Value="#B0B0B0" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Button Text="{Binding ImportButtonText}" 
                        BackgroundColor="#1C1C1E" 
                        TextColor="White" 
                        FontAttributes="Bold" 
                        FontSize="16" 
                        HeightRequest="56" 
                        CornerRadius="16" 
                        ImageSource="{mi:Material Icon=Download, IconColor=White}"
                        Command="{Binding ImportCommand}"
                        IsEnabled="{Binding IsImportEnabled}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsImportEnabled}" Value="False">
                                <Setter Property="BackgroundColor" Value="#A9A9A9" />
                                <Setter Property="TextColor" Value="#666666" />
                                <Setter Property="Opacity" Value="0.8" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>

                </VerticalStackLayout>

                <!-- Предпросмотр -->
                <Label Text="ПРЕДПРОСМОТР" FontSize="13" TextColor="#9595A5" FontAttributes="Bold" Margin="4,0,0,12" />

                <Grid ColumnDefinitions="*, *, *" ColumnSpacing="8" Margin="0,0,0,16">
                    <!-- Таб 1: Карточки -->
                    <Border Grid.Column="0" StrokeThickness="1" Padding="0,12" IsEnabled="{Binding IsCardsImportSelected}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleCardsPreviewCommand}" />
                        </Border.GestureRecognizers>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsCardsPreviewActive}" Value="True">
                                <Setter Property="BackgroundColor" Value="#1C1C1E" />
                                <Setter Property="Stroke" Value="#1C1C1E" />
                            </DataTrigger>
                            <DataTrigger TargetType="Border" Binding="{Binding IsCardsPreviewActive}" Value="False">
                                <Setter Property="BackgroundColor" Value="White" />
                                <Setter Property="Stroke" Value="#EAECEF" />
                            </DataTrigger>
                            <DataTrigger TargetType="Border" Binding="{Binding IsCardsImportSelected}" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                                <Setter Property="BackgroundColor" Value="#E0E0E0" />
                            </DataTrigger>
                        </Border.Triggers>

                        <Label Text="Карточки" HorizontalOptions="Center" FontAttributes="Bold">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsCardsPreviewActive}" Value="True">
                                    <Setter Property="TextColor" Value="White" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding IsCardsPreviewActive}" Value="False">
                                    <Setter Property="TextColor" Value="#1C1C1E" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Border>

                    <!-- Таб 2: Квизы -->
                    <Border Grid.Column="1" StrokeThickness="1" Padding="0,12" IsEnabled="{Binding IsQuizzesImportSelected}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleQuizzesPreviewCommand}" />
                        </Border.GestureRecognizers>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsQuizzesPreviewActive}" Value="True">
                                <Setter Property="BackgroundColor" Value="#1C1C1E" />
                                <Setter Property="Stroke" Value="#1C1C1E" />
                            </DataTrigger>
                            <DataTrigger TargetType="Border" Binding="{Binding IsQuizzesPreviewActive}" Value="False">
                                <Setter Property="BackgroundColor" Value="White" />
                                <Setter Property="Stroke" Value="#EAECEF" />
                            </DataTrigger>
                            <DataTrigger TargetType="Border" Binding="{Binding IsQuizzesImportSelected}" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                                <Setter Property="BackgroundColor" Value="#E0E0E0" />
                            </DataTrigger>
                        </Border.Triggers>

                        <Label Text="Квизы" HorizontalOptions="Center" FontAttributes="Bold">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsQuizzesPreviewActive}" Value="True">
                                    <Setter Property="TextColor" Value="White" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding IsQuizzesPreviewActive}" Value="False">
                                    <Setter Property="TextColor" Value="#1C1C1E" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Border>

                    <!-- Таб 3: Статьи -->
                    <Border Grid.Column="2" StrokeThickness="1" Padding="0,12" IsEnabled="{Binding IsArticlesImportSelected}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleArticlesPreviewCommand}" />
                        </Border.GestureRecognizers>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsArticlesPreviewActive}" Value="True">
                                <Setter Property="BackgroundColor" Value="#1C1C1E" />
                                <Setter Property="Stroke" Value="#1C1C1E" />
                            </DataTrigger>
                            <DataTrigger TargetType="Border" Binding="{Binding IsArticlesPreviewActive}" Value="False">
                                <Setter Property="BackgroundColor" Value="White" />
                                <Setter Property="Stroke" Value="#EAECEF" />
                            </DataTrigger>
                            <DataTrigger TargetType="Border" Binding="{Binding IsArticlesImportSelected}" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                                <Setter Property="BackgroundColor" Value="#E0E0E0" />
                            </DataTrigger>
                        </Border.Triggers>

                        <Label Text="Статьи" HorizontalOptions="Center" FontAttributes="Bold">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsArticlesPreviewActive}" Value="True">
                                    <Setter Property="TextColor" Value="White" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding IsArticlesPreviewActive}" Value="False">
                                    <Setter Property="TextColor" Value="#1C1C1E" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Border>
                </Grid>

                <!-- ========================================== -->
                <!-- ПРЕДПРОСМОТР КАРТОЧЕК (СПИСОК)             -->
                <!-- ========================================== -->
                <VerticalStackLayout IsVisible="{Binding IsCardsPreviewActive}" Spacing="16" BindableLayout.ItemsSource="{Binding PreviewCards}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="domain:Card">
                            <Border BackgroundColor="White" Stroke="#EAECEF" StrokeThickness="1" Padding="16">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>

                                <VerticalStackLayout Spacing="8">
                                    <Label Text="{Binding Title}" FontSize="16" FontAttributes="Bold" TextColor="#1C1C1E" />

                                    <Label Text="ЛИЦЕВАЯ СТОРОНА" FontSize="11" TextColor="#8E8E93" FontAttributes="Bold" Margin="0,8,0,0" />
                                    <controls:MarkdownView TextColor="Black" Text="{Binding FrontMarkdown}" />

                                    <BoxView HeightRequest="1" Color="#EAECEF" Margin="0,4" />

                                    <Label Text="КРАТКИЙ ОТВЕТ" FontSize="11" TextColor="#8E8E93" FontAttributes="Bold" />
                                    <controls:MarkdownView TextColor="Black" Text="{Binding BriefMarkdown}" />

                                    <VerticalStackLayout>
                                        <VerticalStackLayout.Triggers>
                                            <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding DetailedMarkdown}" Value="{x:Null}">
                                                <Setter Property="IsVisible" Value="False" />
                                            </DataTrigger>
                                        </VerticalStackLayout.Triggers>

                                        <BoxView HeightRequest="1" Color="#EAECEF" Margin="0,4" />
                                        <Label Text="ПОДРОБНЫЙ ОТВЕТ" FontSize="11" TextColor="#8E8E93" FontAttributes="Bold" />
                                        <controls:MarkdownView TextColor="Black" Text="{Binding DetailedMarkdown}" />
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- ========================================== -->
                <!-- ПРЕДПРОСМОТР СТАТЕЙ (СПИСОК)               -->
                <!-- ========================================== -->
                <VerticalStackLayout IsVisible="{Binding IsArticlesPreviewActive}" Spacing="16" BindableLayout.ItemsSource="{Binding PreviewArticles}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="domain:Article">
                            <Border BackgroundColor="White" Stroke="#EAECEF" StrokeThickness="1" Padding="16">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>

                                <VerticalStackLayout Spacing="8">
                                    <Label Text="{Binding Title}" FontSize="18" FontAttributes="Bold" TextColor="#1C1C1E" />
                                    <controls:MarkdownView TextColor="Black" Text="{Binding BodyMarkdown}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- ========================================== -->
                <!-- ПРЕДПРОСМОТР КВИЗОВ (СПИСОК)               -->
                <!-- ========================================== -->
                <VerticalStackLayout IsVisible="{Binding IsQuizzesPreviewActive}" Spacing="16" BindableLayout.ItemsSource="{Binding PreviewQuizzes}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="domain:QuizBlock">
                            <Border BackgroundColor="White" Stroke="#EAECEF" StrokeThickness="1" Padding="16">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>

                                <VerticalStackLayout Spacing="16">
                                    <Label Text="{Binding Title}" FontSize="16" FontAttributes="Bold" TextColor="#1C1C1E" />

                                    <VerticalStackLayout Spacing="24" BindableLayout.ItemsSource="{Binding Questions}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="domain:QuizQuestion">
                                                <VerticalStackLayout Spacing="12">
                                                    <Label Text="ВОПРОС" FontSize="11" TextColor="#8E8E93" FontAttributes="Bold" />
                                                    <controls:MarkdownView TextColor="Black" Text="{Binding QuestionMarkdown}" />

                                                    <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Options}">
                                                        <BindableLayout.ItemTemplate>
                                                            <DataTemplate x:DataType="domain:AnswerOption">
                                                                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8">
                                                                    <Grid Grid.Column="0" VerticalOptions="Center">
                                                                        <Image Source="{mi:Material Icon=CheckCircle, IconColor=#34C759}" WidthRequest="22" HeightRequest="22" IsVisible="{Binding IsCorrect}" />
                                                                        <Image Source="{mi:Material Icon=RadioButtonUnchecked, IconColor=#8E8E93}" WidthRequest="22" HeightRequest="22">
                                                                            <Image.Triggers>
                                                                                <DataTrigger TargetType="Image" Binding="{Binding IsCorrect}" Value="True">
                                                                                    <Setter Property="IsVisible" Value="False" />
                                                                                </DataTrigger>
                                                                            </Image.Triggers>
                                                                        </Image>
                                                                    </Grid>

                                                                    <controls:MarkdownView Grid.Column="1" TextColor="Black" Text="{Binding TextMarkdown}" VerticalOptions="Center" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </BindableLayout.ItemTemplate>
                                                    </VerticalStackLayout>

                                                    <VerticalStackLayout>
                                                        <VerticalStackLayout.Triggers>
                                                            <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding ExplanationMarkdown}" Value="{x:Null}">
                                                                <Setter Property="IsVisible" Value="False" />
                                                            </DataTrigger>
                                                        </VerticalStackLayout.Triggers>
                                                        <BoxView HeightRequest="1" Color="#EAECEF" Margin="0,8,0,4" />
                                                        <Label Text="ПОЯСНЕНИЕ" FontSize="11" TextColor="#8E8E93" FontAttributes="Bold" />
                                                        <controls:MarkdownView TextColor="Black" Text="{Binding ExplanationMarkdown}" />
                                                    </VerticalStackLayout>
                                                </VerticalStackLayout>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>


        <!-- ========================================== -->
        <!-- ВСПЛЫВАШКА РЕДАКТОРА КОДА (OVERLAY)        -->
        <!-- ========================================== -->
        <Grid Grid.RowSpan="2" 
              BackgroundColor="#80000000" 
              IsVisible="{Binding IsCodePreviewVisible}" 
              InputTransparent="False">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseCodePreviewCommand}" />
            </Grid.GestureRecognizers>

            <Border BackgroundColor="White" 
                    Margin="24,60" 
                    Padding="16" 
                    VerticalOptions="Center" 
                    StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,10" Radius="20" Opacity="0.1" />
                </Border.Shadow>
                <!-- Перехватываем клики внутри карточки -->
                <Border.GestureRecognizers>
                    <TapGestureRecognizer />
                </Border.GestureRecognizers>

                <Grid RowDefinitions="Auto, *, Auto" RowSpacing="16">
                    <Label Grid.Row="0" Text="Код контента" FontSize="18" FontAttributes="Bold" TextColor="#1C1C1E" HorizontalOptions="Center" />

                    <Border Grid.Row="1" BackgroundColor="#F4F5F8" StrokeThickness="0" Padding="12">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Editor Text="{Binding InputText}"
                                Placeholder="Markdown код здесь..."
                                TextColor="#1C1C1E"
                                BackgroundColor="Transparent"
                                AutoSize="TextChanges" />
                    </Border>

                    <Button Grid.Row="2" 
                            Text="Готово" 
                            BackgroundColor="#1C1C1E" 
                            TextColor="White" 
                            FontAttributes="Bold" 
                            HeightRequest="48"
                            CornerRadius="12"
                            Command="{Binding CloseCodePreviewCommand}" />
                </Grid>
            </Border>
        </Grid>
        <Border Grid.RowSpan="2" 
            BackgroundColor="#1C1C1E"
            Padding="24,12"
            HorizontalOptions="Center"
            VerticalOptions="End"
            Margin="0,0,0,100"
            IsVisible="{Binding IsToastVisible}"
            InputTransparent="True">
            <!-- InputTransparent="True" позволяет кликать "сквозь" уведомление, если оно висит -->

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20" />
            </Border.StrokeShape>

            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,4" Radius="10" Opacity="0.2" />
            </Border.Shadow>

            <Label Text="{Binding ToastMessage}" 
                   TextColor="White" 
                   FontAttributes="Bold" 
                   FontSize="14"
                   HorizontalOptions="Center" />
        </Border>
        
        <!-- ОВЕРЛЕЙ С ПРОМПТОМ -->
        <Grid Grid.RowSpan="2" BackgroundColor="#80000000" IsVisible="{Binding IsPromptOverlayVisible}">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding TogglePromptOverlayCommand}" />
            </Grid.GestureRecognizers>
            
            <Border BackgroundColor="White" Margin="24,80" Padding="20" VerticalOptions="Center" StrokeThickness="0">
                <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                <Border.GestureRecognizers><TapGestureRecognizer /></Border.GestureRecognizers>
                
                <Grid RowDefinitions="Auto, *, Auto" RowSpacing="16" MaximumHeightRequest="400">
                    <Label Grid.Row="0" Text="Вставьте этот промпт в нейросеть (ChatGPT, Claude и т.д.) и попросите её создать контент на заданную вами тему:" 
                           FontSize="14" TextColor="#1C1C1E" FontAttributes="Bold" />
                    
                    <Border Grid.Row="1" BackgroundColor="#F4F5F8" StrokeThickness="0" Padding="12">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                        <ScrollView>
                            <Label Text="{Binding PromptText}" FontSize="13" TextColor="#8E8E93" LineBreakMode="WordWrap" />
                        </ScrollView>
                    </Border>
                    
                    <Button Grid.Row="2" Text="Скопировать промпт" Command="{Binding CopyPromptCommand}" 
                            BackgroundColor="#6278E6" TextColor="White" FontAttributes="Bold" CornerRadius="12" HeightRequest="48" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>