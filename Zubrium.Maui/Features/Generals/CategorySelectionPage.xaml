<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Zubrium.Maui.Features.Generals"
             x:Class="Zubrium.Maui.Features.Generals.CategorySelectionPage"
             x:DataType="local:CategorySelectionViewModel"
             x:Name="PageRoot"
             BackgroundColor="#F4F5F8">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <Label Text="Категория" FontSize="20" FontAttributes="Bold" TextColor="#1C1C1E" />
            <Entry Text="{Binding SearchText}" Placeholder="Поиск или новая категория" />
            <CollectionView ItemsSource="{Binding Categories}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="local:CategoryDraft">
                        <Border Stroke="#EAECEF" StrokeThickness="1" Padding="14" Margin="0,0,0,12">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding BindingContext.SelectCommand, Source={x:Reference PageRoot}}" CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Name}" FontSize="16" FontAttributes="Bold" TextColor="#1C1C1E" />
                                <Label Text="Создать новую категорию" FontSize="12" TextColor="#6278E6" IsVisible="{Binding IsNew}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <Button Text="Назад" Command="{Binding GoBackCommand}" BackgroundColor="#E0E0E0" TextColor="#1C1C1C" CornerRadius="12" HeightRequest="48" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
