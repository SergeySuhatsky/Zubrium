<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:local="clr-namespace:Zubrium.Maui.Features.Articles"
             xmlns:vm="clr-namespace:Zubrium.Maui.ViewModels"
             x:Class="Zubrium.Maui.Features.Articles.ArticlePage"
             x:DataType="local:ArticleViewModel"
             x:Name="ArticlesPageRoot"
             BackgroundColor="#F4F5F8">
    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="20,20,20,100" Spacing="20">
                <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                    <Label Text="Статьи"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="#1C1C1E"
                           VerticalOptions="Center" />

                    <Label Grid.Column="1"
                           Text="ИМПОРТИРОВАТЬ"
                           FontSize="12"
                           TextColor="#6278E6"
                           TextTransform="Uppercase"
                           FontAttributes="Bold"
                           VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ImportCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

                <Border BackgroundColor="#EFEFF4"
                        StrokeThickness="0"
                        Padding="16,8">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto, *">
                        <Image Grid.Column="0"
                               Source="{mi:Material Icon=Search, IconColor=#8E8E93}"
                               WidthRequest="22"
                               HeightRequest="22"
                               VerticalOptions="Center"
                               Margin="0,0,12,0" />
                        <Entry Grid.Column="1"
                               Text="{Binding SearchText}"
                               Placeholder="Поиск..."
                               PlaceholderColor="#8E8E93"
                               TextColor="#1C1C1E"
                               BackgroundColor="Transparent"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Border BackgroundColor="White"
                        Stroke="#EAECEF"
                        StrokeThickness="1"
                        Padding="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#000000" Offset="0,4" Radius="12" Opacity="0.03" />
                    </Border.Shadow>

                    <CollectionView ItemsSource="{Binding Categories}" SelectionMode="None">
                        <CollectionView.EmptyView>
                            <Label Text="Категорий пока нет" TextColor="#8E8E93" HorizontalOptions="Center" Margin="20" />
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:CategoryDisplayModel">
                                <VerticalStackLayout>
                                    <Grid ColumnDefinitions="Auto, *" Padding="16,18" ColumnSpacing="16" BackgroundColor="Transparent">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding BindingContext.OpenCategoryCommand, Source={x:Reference ArticlesPageRoot}}"
                                                                  CommandParameter="{Binding CategoryId}" />
                                        </Grid.GestureRecognizers>
                                        <Grid.Behaviors>
                                            <toolkit:TouchBehavior DefaultBackgroundColor="Transparent"
                                                                   PressedBackgroundColor="#F2F2F6"
                                                                   DefaultOpacity="1.0"
                                                                   PressedOpacity="0.5"
                                                                   PressedAnimationDuration="100"
                                                                   DefaultAnimationDuration="100" />
                                        </Grid.Behaviors>

                                        <Image Grid.Column="0"
                                               Source="{mi:Material Icon=Article}"
                                               WidthRequest="28"
                                               HeightRequest="28"
                                               VerticalOptions="Center"
                                               InputTransparent="True">
                                            <Image.Behaviors>
                                                <toolkit:IconTintColorBehavior TintColor="{Binding IconColor}" />
                                            </Image.Behaviors>
                                        </Image>

                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4" InputTransparent="True">
                                            <Label Text="{Binding Name}" FontSize="16" TextColor="#2C2C2E" FontAttributes="Bold" />
                                            <Label Text="{Binding ItemCountText}" FontSize="13" TextColor="#8E8E93" />
                                        </VerticalStackLayout>
                                    </Grid>

                                    <BoxView HeightRequest="1" Color="#F2F2F6" Margin="16,0" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>