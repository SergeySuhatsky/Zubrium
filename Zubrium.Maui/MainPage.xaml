<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:md="clr-namespace:Zubrium.Maui.Views.Controls"
             x:Class="Zubrium.Maui.MainPage">

    <Grid RowDefinitions="Auto, 120, Auto, 200" Padding="20" RowSpacing="10">

        <!-- Заголовок -->
        <Label Text="Markdown Renderer Test" FontSize="24" FontAttributes="Bold" Grid.Row="0" />

        <!-- Поле ввода -->
        <VerticalStackLayout Grid.Row="1" Spacing="5">
            <Label Text="Enter Markdown:" FontSize="14" FontAttributes="Bold" />
            <Editor 
            x:Name="MarkdownInput"
            Placeholder="Type markdown here..."
            Text="# Hello&#10;&#10;This is **bold** and *italic* text."/>
        </VerticalStackLayout>

        <!-- Кнопка -->
        <Button 
        x:Name="RenderBtn"
        Text="Render Markdown"
        Clicked="OnRenderClicked"
        BackgroundColor="#2196F3"
        TextColor="White"
        Grid.Row="2" />





        <Grid  Grid.Row="3" x:Name="CardsContainer" Padding="20">

            <!-- Карточка -->
            <Frame x:Name="TopCard" 
           BackgroundColor="MediumPurple" 
           CornerRadius="20" 
           HasShadow="True" 
           Padding="0"
           WidthRequest="300"
           HeightRequest="450"
           HorizontalOptions="Center" 
           VerticalOptions="Center">

                <Frame.GestureRecognizers>
                    <!-- Привязываем обработчик жеста перетаскивания -->
                    <PanGestureRecognizer PanUpdated="OnCardPanUpdated" />
                </Frame.GestureRecognizers>

                <!-- Результат -->
                <Grid  >
                    <Label Text="Result:" FontSize="14" FontAttributes="Bold" />
                    <ScrollView >
                        <md:MarkdownView 
                 x:Name="MarkdownRenderer1"
                 BaseFontSize="14" 
                 />

                        <!--<VerticalStackLayout x:Name="RenderersContainer" Spacing="15" />-->
                    </ScrollView>
                </Grid>
            </Frame>
        </Grid>

    </Grid>

</ContentPage>
